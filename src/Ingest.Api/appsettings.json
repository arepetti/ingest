{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ingest": "mongodb://localhost:27017/ingest"
  },
  "Mongo": {
    "Database": "ingest"
  },
  "ApiKey": {
    "HeaderName": "X-Api-Key",
    "Pepper": "dev-pepper-change-me",
    "BootstrapAdminName": "Admin"
  },
  "Ingest": {
    "EnableSwagger": true,
    "DefaultStatusPeriod": "week",
    "CorsDevOrigins": [ "http://localhost:5173" ]
  }
}
