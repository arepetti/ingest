{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ingest": "mongodb://localhost:27017/ingest"
  },
  "Mongo": {
    "Database": "ingest"
  },
  "ApiKey": {
    "HeaderName": "X-Api-Key",
    "Pepper": "dev-pepper-change-me",
    "BootstrapAdminName": "Admin"
  },
  "Ingest": {
    "EnableSwagger": true,
    "DefaultStatusPeriod": "week",
    "CorsDevOrigins": [ "http://localhost:5173" ]
  },
  "Approval": {
    "Enabled": true
  },
  "Pdf": {
    "GotenbergUrl": "http://localhost:3000",
    "RequestTimeoutSeconds": 60
  },
  "Retention": {
    "Enabled": false,
    "PollHours": 24,
    "SentEmailsDays": 0,
    "AuditLogDays": 0,
    "SoftDeletedDays": 0,
    "NotificationLogDays": 0
  },
  "Webhooks": {
    "Enabled": true,
    "RequestTimeoutSeconds": 10,
    "AllowedHostSuffixes": [],
    "Worker": {
      "Enabled": true,
      "PollSeconds": 15,
      "MaxAttempts": 6,
      "BatchSize": 25
    }
  },
  "Sso": {
    "EnableSso": true,
    "CookieName": "ingest.session",
    "Providers": [
      {
        "Id": "Microsoft",
        "DisplayName": "Microsoft",
        "Authority": "https://login.microsoftonline.com/common/v2.0",
        "ClientId": "",
        "ClientSecret": "",
        "Scopes": [ "openid", "profile", "email" ]
      },
      {
        "Id": "Google",
        "DisplayName": "Google",
        "Authority": "https://accounts.google.com",
        "ClientId": "",
        "ClientSecret": "",
        "Scopes": [ "openid", "profile", "email" ]
      }
    ]
  }
}
