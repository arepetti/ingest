{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ingest": "mongodb://localhost:27017/ingest"
  },
  "Mongo": {
    "Database": "ingest"
  },
  "ApiKey": {
    "HeaderName": "X-Api-Key",
    "Pepper": "dev-pepper-change-me",
    "BootstrapAdminName": "Admin"
  },
  "Ingest": {
    "EnableSwagger": true,
    "DefaultStatusPeriod": "week",
    "CorsDevOrigins": [ "http://localhost:5173" ]
  },
  "Sso": {
    "EnableSso": false,
    "CookieName": "ingest.session",
    "Providers": [
      {
        "Id": "Microsoft",
        "DisplayName": "Microsoft",
        "Authority": "https://login.microsoftonline.com/common/v2.0",
        "ClientId": "",
        "ClientSecret": "",
        "Scopes": [ "openid", "profile", "email" ]
      },
      {
        "Id": "Google",
        "DisplayName": "Google",
        "Authority": "https://accounts.google.com",
        "ClientId": "",
        "ClientSecret": "",
        "Scopes": [ "openid", "profile", "email" ]
      }
    ]
  }
}
