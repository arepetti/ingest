+name: Build and publish Docker image
+
+# Manual-only: trigger from the Actions tab (Run workflow). Nothing runs on push/PR.
+on:
+  workflow_dispatch:
+    inputs:
+      tag:
+        description: "Image tag to publish (the commit SHA is always published too)"
+        required: false
+        default: "latest"
+
+env:
+  REGISTRY: ghcr.io
+
+jobs:
+  build-and-push:
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+      packages: write # needed to push to GHCR with the built-in GITHUB_TOKEN
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Compute lowercase image name
+        id: image
+        # GHCR requires an all-lowercase path; owner/repo may contain uppercase.
+        run: echo "name=${REGISTRY}/${GITHUB_REPOSITORY,,}" >> "$GITHUB_OUTPUT"
+
+      - name: Set up Docker Buildx
+        uses: docker/setup-buildx-action@v3
+
+      - name: Log in to GitHub Container Registry
+        uses: docker/login-action@v3
+        with:
+          registry: ${{ env.REGISTRY }}
+          username: ${{ github.actor }}
+          password: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Build and push
+        uses: docker/build-push-action@v6
+        with:
+          context: .
+          file: ./Dockerfile
+          push: true
+          tags: |
+            ${{ steps.image.outputs.name }}:${{ inputs.tag }}
+            ${{ steps.image.outputs.name }}:${{ github.sha }}
+          cache-from: type=gha
+          cache-to: type=gha,mode=max
+
+      - name: Job summary
+        run: |
+          {
+            echo "### Published image"
+            echo ""
+            echo "- \`${{ steps.image.outputs.name }}:${{ inputs.tag }}\`"
+            echo "- \`${{ steps.image.outputs.name }}:${{ github.sha }}\`"
+            echo ""
+            echo "The package is created **private** by default — make it public from the"
+            echo "package settings if you want anonymous \`docker pull\`."
+          } >> "$GITHUB_STEP_SUMMARY"
