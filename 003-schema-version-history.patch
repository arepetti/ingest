+    queryKey: ['schema-version-history', name, params],
+    queryFn: () => api.get<Paged<SchemaVersionHistoryEntry>>(`/api/admin/schemas/${encodeURIComponent(name!)}/version-history?${search}`),
+    enabled: !!name && enabled,
