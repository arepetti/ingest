+    setError(null); setResult(null); setCopied(false)
+  }
+
+  async function onFinish() {
+    setError(null)
+    try {
+      const req: CreateAccountRequest = {
+        name: trimmedName,
+        label: label.trim() || null,
+        email: trimmedEmail,
+        kind,
+        role,
+        enabled: true,
+      }
