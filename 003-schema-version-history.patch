diff --git a/src/Ingest.Infrastructure/Mongo/SchemaVersionHistoryRepository.cs b/src/Ingest.Infrastructure/Mongo/SchemaVersionHistoryRepository.cs
new file mode 100644
index 0000000..668c25a
--- /dev/null
