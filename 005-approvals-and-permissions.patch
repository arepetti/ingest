+                  id={`cap-${item.id}`}
+                  label={item.label}
+                  checked={isAdmin ? true : isService ? false : set.has(item.id)}
+                  disabled={readOnly}
+                  onChange={(_, d) => toggle(item.id, !!d.checked)}
