table Calendar
	lineageTag: b0000000-0000-0000-0000-0000000000b0
	dataCategory: Time

	column Date
		isKey
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: [Date]
		lineageTag: e0000000-0000-0000-0000-000000000001

	column Year = YEAR ( 'Calendar'[Date] )
		dataType: int64
		formatString: 0
		summarizeBy: none
		lineageTag: e0000000-0000-0000-0000-000000000002

	column MonthNumber = MONTH ( 'Calendar'[Date] )
		dataType: int64
		formatString: 0
		summarizeBy: none
		lineageTag: e0000000-0000-0000-0000-000000000003

	column Month = FORMAT ( 'Calendar'[Date], "mmm yyyy" )
		dataType: string
		summarizeBy: none
		sortByColumn: MonthKey
		lineageTag: e0000000-0000-0000-0000-000000000004

	column MonthKey = ( YEAR ( 'Calendar'[Date] ) * 100 ) + MONTH ( 'Calendar'[Date] )
		dataType: int64
		formatString: 0
		summarizeBy: none
		lineageTag: e0000000-0000-0000-0000-000000000005

	column Quarter = "Q" & FORMAT ( 'Calendar'[Date], "q yyyy" )
		dataType: string
		summarizeBy: none
		lineageTag: e0000000-0000-0000-0000-000000000006

	partition Calendar = calculated
		mode: import
		source = CALENDAR ( DATE ( 2024, 1, 1 ), DATE ( 2027, 12, 31 ) )

	annotation PBI_Id = Calendar
